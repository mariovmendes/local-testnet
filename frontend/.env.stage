# Stage frontend template.
#
# Do not commit environment-specific endpoints, contract addresses, or wallet
# credentials here. Keep local overrides in .env.stage.local, which is ignored
# by git. In deployed environments, inject these values from the deployment
# system or secret store.
#
# All VITE_* variables are exposed to browser JavaScript. Do not put secrets in
# VITE_* variables. VITE_WALLET_PRIVATE_KEY is restricted to local development
# and must stay in .env.stage.local.

# Rollup chain IDs.
VITE_CHAIN_A_ID=
VITE_CHAIN_B_ID=

# Use builder RPCs for flashblocks. Set false to use OP reth RPCs.
VITE_FLASHBLOCKS_ENABLED=

# Vite dev-server proxy targets. These are read by vite.config.ts only and are
# not exposed to the browser. Use external RPC URLs, or localhost
# port-forwards for private k8s services.
STAGE_CHAIN_A_BUILDER_RPC_TARGET=
STAGE_CHAIN_A_OP_RETH_RPC_TARGET=
STAGE_CHAIN_B_BUILDER_RPC_TARGET=
STAGE_CHAIN_B_OP_RETH_RPC_TARGET=
STAGE_SIDECAR_A_TARGET=
STAGE_SIDECAR_B_TARGET=

# Browser-facing same-origin routes. For local development these normally stay
# as proxy paths. In deployed environments, the serving ingress or reverse proxy
# must route these paths to the configured RPC and sidecar backends.
VITE_CHAIN_A_BUILDER_RPC=
VITE_CHAIN_A_OP_RETH_RPC=
VITE_CHAIN_B_BUILDER_RPC=
VITE_CHAIN_B_OP_RETH_RPC=
VITE_SIDECAR_A_URL=
VITE_SIDECAR_B_URL=

# Explorer URLs used for transaction links.
VITE_CHAIN_A_BLOCKSCOUT_URL=
VITE_CHAIN_B_BLOCKSCOUT_URL=

# Leave empty to disable localnet-health and probe configured RPC/sidecar
# endpoints directly. Set only when running against a localnet-health service.
VITE_HEALTH_API_URL=

# Contract addresses. Use addresses from the active contracts deployment for
# the target environment.
VITE_CHAIN_A_BRIDGE_ADDRESS=
VITE_CHAIN_B_BRIDGE_ADDRESS=
VITE_CHAIN_A_TOKEN_ADDRESS=
VITE_CHAIN_B_TOKEN_ADDRESS=
VITE_CET_FACTORY_ADDRESS=
VITE_CHAIN_A_ETH_LIQUIDITY_ADDRESS=
VITE_CHAIN_B_ETH_LIQUIDITY_ADDRESS=

# Local development only. Never commit a private key here.
VITE_WALLET_PRIVATE_KEY=
