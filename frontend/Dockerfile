# Dev stage - hot reload via Vite dev server
FROM oven/bun:alpine AS dev

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Source is mounted as a volume at runtime; env vars are passed via environment
EXPOSE 3000

CMD ["bun", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]

# Build stage
FROM oven/bun:alpine AS builder

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

# Build args for Vite env (injected at build time)
ARG VITE_CHAIN_A_ID=77777
ARG VITE_CHAIN_B_ID=88888
ARG VITE_FLASHBLOCKS_ENABLED=true
ARG VITE_EL_CLIENT_LABEL=op-reth
ARG VITE_CHAIN_A_BUILDER_RPC=http://localhost:17545
ARG VITE_CHAIN_A_OP_RETH_RPC=http://localhost:18545
ARG VITE_CHAIN_B_BUILDER_RPC=http://localhost:27545
ARG VITE_CHAIN_B_OP_RETH_RPC=http://localhost:28545
ARG VITE_SIDECAR_A_URL=http://localhost:17090
ARG VITE_SIDECAR_B_URL=http://localhost:27090
ARG VITE_HEALTH_API_URL=http://localhost:8090
ARG VITE_CHAIN_A_BRIDGE_ADDRESS
ARG VITE_CHAIN_B_BRIDGE_ADDRESS
ARG VITE_CHAIN_A_TOKEN_ADDRESS
ARG VITE_CHAIN_B_TOKEN_ADDRESS
ARG VITE_CET_FACTORY_ADDRESS
ARG VITE_CHAIN_A_ETH_LIQUIDITY_ADDRESS
ARG VITE_CHAIN_B_ETH_LIQUIDITY_ADDRESS
ARG VITE_WALLET_PRIVATE_KEY

ENV VITE_CHAIN_A_ID=$VITE_CHAIN_A_ID
ENV VITE_CHAIN_B_ID=$VITE_CHAIN_B_ID
ENV VITE_FLASHBLOCKS_ENABLED=$VITE_FLASHBLOCKS_ENABLED
ENV VITE_EL_CLIENT_LABEL=$VITE_EL_CLIENT_LABEL
ENV VITE_CHAIN_A_BUILDER_RPC=$VITE_CHAIN_A_BUILDER_RPC
ENV VITE_CHAIN_A_OP_RETH_RPC=$VITE_CHAIN_A_OP_RETH_RPC
ENV VITE_CHAIN_B_BUILDER_RPC=$VITE_CHAIN_B_BUILDER_RPC
ENV VITE_CHAIN_B_OP_RETH_RPC=$VITE_CHAIN_B_OP_RETH_RPC
ENV VITE_SIDECAR_A_URL=$VITE_SIDECAR_A_URL
ENV VITE_SIDECAR_B_URL=$VITE_SIDECAR_B_URL
ENV VITE_HEALTH_API_URL=$VITE_HEALTH_API_URL
ENV VITE_CHAIN_A_BRIDGE_ADDRESS=$VITE_CHAIN_A_BRIDGE_ADDRESS
ENV VITE_CHAIN_B_BRIDGE_ADDRESS=$VITE_CHAIN_B_BRIDGE_ADDRESS
ENV VITE_CHAIN_A_TOKEN_ADDRESS=$VITE_CHAIN_A_TOKEN_ADDRESS
ENV VITE_CHAIN_B_TOKEN_ADDRESS=$VITE_CHAIN_B_TOKEN_ADDRESS
ENV VITE_CET_FACTORY_ADDRESS=$VITE_CET_FACTORY_ADDRESS
ENV VITE_CHAIN_A_ETH_LIQUIDITY_ADDRESS=$VITE_CHAIN_A_ETH_LIQUIDITY_ADDRESS
ENV VITE_CHAIN_B_ETH_LIQUIDITY_ADDRESS=$VITE_CHAIN_B_ETH_LIQUIDITY_ADDRESS
ENV VITE_WALLET_PRIVATE_KEY=$VITE_WALLET_PRIVATE_KEY

RUN bun run build

# Serve stage
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
