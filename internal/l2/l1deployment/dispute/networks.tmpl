[networks.{{.NetworkName}}]
name = "{{.NetworkName}}"
rpc_url = "{{.RpcURL}}"
chain_id = {{.ChainID}}
explorer_url = "{{.ExplorerURL}}"
explorer_api_url = "{{.ExplorerAPIURL}}"

# ComposeL2OutputOracle initialization parameters
verifier_address = "{{.VerifierAddress}}"
owner_address = "{{.OwnerAddress}}"
proposer_address = "{{.ProposerAddress}}"
aggregation_vkey = "{{.AggregationVkey}}"
starting_superblock_number = 0

# DisputeGameFactory initialization parameters
# admin_address must be the deployer wallet - ProxyAdmin is created with this owner
# and upgradeAndCall is called in the same broadcast (same msg.sender).
admin_address = "{{.DeployerAddress}}"